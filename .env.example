# ════════════════════════════════════════════════════════════════
#  LLM-Konfiguration – kopiere diese Datei nach `.env` und passe an
# ════════════════════════════════════════════════════════════════

# ── Provider wählen ───────────────────────────────────────────────
#   openai_compatible = lokaler OpenAI-kompatibler Endpoint (LM Studio, Ollama, vLLM …)
#   openai            = ChatGPT API
#   anthropic         = Claude API (benötigt: langchain-anthropic)
PROVIDER=openai_compatible

# ── Endpoint & Modell ─────────────────────────────────────────────
# Lokal (LM Studio): http://localhost:1235/v1
# ChatGPT:           https://api.openai.com/v1  (oder leer lassen → Default)
BASE_URL=http://localhost:1235/v1

# Lokale Endpoints ignorieren den Key meist – ein Platzhalter reicht.
API_KEY=not-needed-locally

# ⚠️ Muss zum geladenen Modell in LM Studio passen!
#    (LM Studio → "My Models" → dort steht der exakte Name)
MODEL_NAME=gpt-oss-20b

# ── Generierung ───────────────────────────────────────────────────
TEMPERATURE=0.2
